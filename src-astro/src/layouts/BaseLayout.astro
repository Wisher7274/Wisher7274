---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

const pathname = Astro.url.pathname;
const isHome = pathname === '/roadmap-for-myself/' || pathname === '/roadmap-for-myself';
const isAbout = pathname.startsWith('/roadmap-for-myself/about');
---
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Nothing but wish</title>
    <ClientRouter />
	</head>
	
    <!-- 导航：隐藏吸附顶部，鼠标靠近时显示 -->
    <header class="fixed top-0 left-0 right-0 z-50 h-15
      group">
      <nav class="w-full flex items-center justify-between px-6 md:px-10 py-2
        bg-white/20 backdrop-blur-md border-b border-white/20
        shadow-sm shadow-slate-200/10
        opacity-0 -translate-y-full
        group-hover:opacity-100 group-hover:translate-y-0
        transition-all duration-300 ease-out">
        <h2>WISHER</h2>
        <!-- 导航链接 -->
        <div class="flex items-center gap-1">
          <a
            href="/roadmap-for-myself/"
            class={`px-4 py-1.5 text-sm font-medium rounded-md transition-colors duration-200
              ${isHome ? 'text-cyan-400' : 'text-slate-500 hover:text-slate-700 hover:bg-slate-100/50'}`}>
            首页
          </a>
          <a
            href="/roadmap-for-myself/about/"
            class={`px-4 py-1.5 text-sm font-medium rounded-md transition-colors duration-200
              ${isAbout ? 'text-cyan-400' : 'text-slate-500 hover:text-slate-700 hover:bg-slate-100/50'}`}>
            介绍
          </a>
        </div>
      </nav>
    </header>
	<main>
		<slot />
	</main>
    <footer class="relative border-t border-slate-200 bg-white py-5 z-20">
      <!-- 顶部分隔渐变线 -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 h-px w-32 bg-linear-to-r from-transparent via-cyan-400 to-transparent" />

      <div class="flex flex-col sm:flex-row items-center justify-between gap-2 px-6 md:px-10 text-sm text-slate-400">
        <!-- 左侧：版权 & 备案 -->
        <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4">
          <p>&copy; 2026 Jacob Lee. All rights reserved.</p>
          <!-- <a href="https://beian.miit.gov.cn/" target="_blank" class="hover:text-slate-500 transition-colors">ICP备XXXXXXXX号</a> -->
        </div>

        <!-- 右侧：署名 -->
        <p>
          Made by <span class="font-medium text-slate-500">Wisher7274</span> with 💗
        </p>
      </div>
    </footer>
</html>